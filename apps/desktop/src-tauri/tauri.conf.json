{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nodrec",
  "version": "0.1.4",
  "identifier": "com.nodrec.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nodrec",
        "width": 1200,
        "height": 760,
        "minWidth": 490,
        "minHeight": 310,
        "decorations": false,
        "zoomHotkeysEnabled": true,
        "backgroundColor": "#17191e",
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "resources": {
      "../blueprints/builtin/": "blueprints/builtin/"
    },
    "windows": {
      "nsis": {
        "startMenuFolder": "Nodrec",
        "installerHooks": "installer-hooks.nsh",
        "installMode": "currentUser",
        "languages": [
          "English"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/JasonMa0012/Nodrec/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMyOUUxRkQ0QTk5QUNBQkQKUldTOXlwcXAxQitlTWhrQU5XK2dIYmIzSUZRTUtvbE9oSm1SaGZhWjM2VmZKeEdJV0NPcVpKZjkK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
